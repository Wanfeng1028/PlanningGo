# ── 通用配置 ──
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 前端 ──
VITE_API_BASE=http://127.0.0.1:3001

# ── PostgreSQL ──
DATABASE_URL=postgresql://planninggo:planninggo@localhost:5432/planninggo?schema=public

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── JWT（开发环境可留空，生产环境必须替换为强密钥） ──
# 生成方式：openssl rand -hex 32
# 生产环境要求：至少 32 位随机字符串，不能使用默认值
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── 密码 ──
BCRYPT_ROUNDS=10

# ── 规划模式: mock | llm | hybrid ──
# mock 模式不需要 LLM Key，可直接启动
PLANNING_MODE=hybrid
ENABLE_LLM_FALLBACK=true

# ── LLM（可选，PLANNING_MODE=llm 或 hybrid 时需要） ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_FLASH_MODEL=gpt-4o-mini
LLM_PRO_MODEL=gpt-4o
LLM_TIMEOUT_MS=30000
# ── Agent Chat / Runtime ──
AGENT_CHAT_MODE=llm
LLM_PROVIDER_PRIORITY=auto
LLM_PROVIDER_FALLBACK=false
LLM_EXPOSE_DIAGNOSTICS=false

# ── DeepSeek（可选）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=
DEEPSEEK_PRO_MODEL=

# ── Moonshot（可选）──
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_FLASH_MODEL=
MOONSHOT_PRO_MODEL=

# ── Groq（可选）──
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FLASH_MODEL=
GROQ_PRO_MODEL=

# ── Gemini（可选）──
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_FLASH_MODEL=
GEMINI_PRO_MODEL=

# ── 豆包/Doubao（可选，Volcengine OpenAI 兼容）──
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_FLASH_MODEL=
DOUBAO_PRO_MODEL=

# ── MiMo（可选，小米大模型 OpenAI 兼容）──
MIMO_API_KEY=
MIMO_BASE_URL=https://api.mimo.ai/v1
MIMO_FLASH_MODEL=
MIMO_PRO_MODEL=
# MiMo 是否支持 OpenAI 兼容的 function/tool calling（默认 false，确认后改为 true）
MIMO_SUPPORTS_TOOL_CALLING=true
# MiMo 推荐配置：MIMO_FLASH_MODEL=mimo-v2.5-pro
# MIMO_PRO_MODEL=mimo-v2.5-pro
# LLM_PROVIDER_PRIORITY=mimo
# AGENT_CHAT_MODE=llm

# ── 生产环境推荐 MiMo 配置示例 ──
# MIMO_API_KEY=your-mimo-api-key-here
# MIMO_BASE_URL=https://api.mimo.ai/v1
# MIMO_FLASH_MODEL=mimo-v2.5-pro
# LLM_PROVIDER_PRIORITY=mimo
# AGENT_CHAT_MODE=llm
# PLANNING_MODE=llm

# ── LongCat（可选，美团大模型 OpenAI 兼容）──
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.ai/openai/v1
LONGCAT_FLASH_MODEL=
LONGCAT_PRO_MODEL=

# ── Claude（可选，Anthropic API，需要 adapter）──
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Grok（可选，xAI API，需要 adapter）──
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai
GROK_MODEL=grok-3

# ── 高德地图（可选，高德地图服务密钥） ──
# 前端 JS API Key（用于 RealMap 组件，高德开放平台 → 控制台 → 应用管理 → 创建应用 → 添加 Key → 选择"Web端(JS API)"）
VITE_AMAP_KEY=
# 后端 Web 服务 Key（用于 AMAP 逆地理编码、POI 搜索等 REST API）
AMAP_WEB_SERVICE_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_MS=5000
AMAP_MAX_CALLS_FLASH=8
AMAP_MAX_CALLS_PRO=16

# ── 开源地图服务（生产建议接自建或托管 OSM 兼容服务） ──
# 开发环境默认可使用公共演示端点跑通闭环；生产环境请替换为自建/托管服务。
# 瓦片：可接 OSM/自建 tile server；搜索/逆地理：Nominatim；周边：Overpass；路线：OSRM 或兼容服务。
OPEN_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
OPEN_MAP_NOMINATIM_URL=https://nominatim.openstreetmap.org
OPEN_MAP_OVERPASS_URL=https://overpass-api.de/api/interpreter
OPEN_MAP_ROUTE_URL=https://router.project-osrm.org
OPEN_MAP_TIMEOUT_MS=5000
# 生产环境如临时使用公共演示端点，必须显式设为 true；正式上线建议保持 false 并配置自有端点。
OPEN_MAP_PUBLIC_DEMO_OK=false

# ── 和风天气（可选，瑞雪天气） ──
QWEATHER_API_KEY=

# ── 美团 OAuth（可选，尚未完全实现） ──
MEITUAN_APP_KEY=
MEITUAN_APP_SECRET=
MEITUAN_REDIRECT_URI=http://127.0.0.1:3001/api/auth/meituan/callback
MEITUAN_AUTH_URL=https://openapi.meituan.com/oauth2/authorize
MEITUAN_TOKEN_URL=
MEITUAN_USERINFO_URL=

# ── 执行引擎 ──
AUTO_EXECUTION_ENABLED=false
AUTO_EXECUTION_MAX_ACTIONS=6
AUTO_EXECUTION_ALLOW_PAYMENT=false
ACTION_TOKEN_TTL_MINUTES=15

# ── 移动端接续 ──
PUBLIC_APP_URL=http://localhost:5173
HANDOFF_TOKEN_TTL_SECONDS=300
HANDOFF_QR_ENABLED=true

# ── 可观测性 ──
ENABLE_TOOL_LOGS=true
ENABLE_USER_EVENTS=true
ENABLE_CLIENT_ERRORS=true

# ── Qwen（可选） ──
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_FLASH_MODEL=
QWEN_PRO_MODEL=
QWEN_ENABLE_THINKING=false

# ── 错误追踪（可选） ──
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ── 负载测试 ──
LOAD_TEST_BASE_URL=http://127.0.0.1:3001

# ── 评审模式（比赛演示专用，非评审模式请保持默认） ──
# DEMO_MODE=true — 启用演示模式：稳定触发可解释链路，不改变功能逻辑
DEMO_MODE=false
# AGENT_CHAT_MODE=rule — 评审时建议用 rule 模式，不依赖 LLM Key，链路稳定可复现
# MOCK_BOOKING_FAILURES=no_seat,no_ticket — 评审时开启，稳定触发预约失败 fallback（无座/无票）
MOCK_BOOKING_FAILURES=
# MOCK_LATENCY_MS=800 — 模拟外部 API 延迟（评审时设 800 让链路可视化更明显）
MOCK_LATENCY_MS=0

# ── Cookie 密钥（生产环境必须配置，至少 32 位） ──
COOKIE_SECRET=

