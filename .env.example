# ── 应用基础 ──
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 前端 ──
VITE_API_BASE=http://127.0.0.1:3001

# ── PostgreSQL ──
DATABASE_URL=postgresql://planninggo:planninggo@localhost:5432/planninggo?schema=public

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── JWT（生产环境必须替换为强密钥）──
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-32b
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-32b
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── 加密 ──
BCRYPT_ROUNDS=10

# ── 规划引擎: mock | llm | hybrid ──
# mock 模式不需要 LLM Key，可直接启动
PLANNING_MODE=mock
ENABLE_LLM_FALLBACK=false

# ── LLM（可选，PLANNING_MODE=llm 或 hybrid 时需要）──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_FLASH_MODEL=gpt-4o-mini
LLM_PRO_MODEL=gpt-4o
LLM_TIMEOUT_MS=30000

# ── 地图（可选，高德逆地理编码）──
AMAP_WEB_SERVICE_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_MS=5000
AMAP_MAX_CALLS_FLASH=8
AMAP_MAX_CALLS_PRO=16

# ── 天气（可选，和风天气）──
QWEATHER_API_KEY=

# ── 美团 OAuth（可选，未配置时后端正常启动）──
MEITUAN_APP_KEY=
MEITUAN_APP_SECRET=
MEITUAN_REDIRECT_URI=http://127.0.0.1:3001/api/auth/meituan/callback
MEITUAN_AUTH_URL=https://openapi.meituan.com/oauth2/authorize
MEITUAN_TOKEN_URL=
MEITUAN_USERINFO_URL=

# ── 执行引擎 ──
AUTO_EXECUTION_ENABLED=false
AUTO_EXECUTION_MAX_ACTIONS=6
AUTO_EXECUTION_ALLOW_PAYMENT=false
ACTION_TOKEN_TTL_MINUTES=15

# ── 移动端接续 ──
PUBLIC_APP_URL=http://localhost:5173
HANDOFF_TOKEN_TTL_SECONDS=300
HANDOFF_QR_ENABLED=true

# ── 可观测性 ──
ENABLE_TOOL_LOGS=true
ENABLE_USER_EVENTS=true
ENABLE_CLIENT_ERRORS=true

# ── Qwen（可选）──
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_FLASH_MODEL=
QWEN_PRO_MODEL=
QWEN_ENABLE_THINKING=false

# ── 监控预留（可选）──
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ── 负载测试 ──
LOAD_TEST_BASE_URL=http://127.0.0.1:3001
