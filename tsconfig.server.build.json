{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.build.tsbuildinfo"
  },
  "include": ["src/server/**/*.ts", "src/generated/prisma/**/*.js"],
  "exclude": ["src/server/**/*.test.ts"]
}
