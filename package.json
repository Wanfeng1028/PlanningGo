{
  "name": "planning-go",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:full": "concurrently -n FE,BE -c cyan,green \"npm run dev\" \"npm run dev:api\"",
    "build": "npm run build:client && npm run build:server",
    "build:server": "tsc -p tsconfig.server.build.json && node -e \"const fs=require('fs');fs.cpSync('src/generated/prisma','dist/generated/prisma',{recursive:true})\"",
    "build:client": "vite build",
    "start:api": "node dist/server/index.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "load:health": "node scripts/load-plan.js --path /api/health --method GET --duration 10",
    "load:plan": "node scripts/load-plan.js",
    "load:flow": "node scripts/load-flow.js",
    "smoke:health": "node scripts/smoke-health.mjs",
    "smoke:llm": "node scripts/smoke-llm.mjs",
    "smoke:chat": "node scripts/smoke-chat.mjs",
    "smoke:plan": "node scripts/smoke-plan.mjs",
    "smoke:all": "node scripts/smoke-all.mjs",
    "smoke:auth-history": "node scripts/smoke-auth-history.mjs",
    "debug:conversations": "node scripts/debug-conversations.mjs",
    "dev:clean-anonymous": "node scripts/dev-clean-anonymous.mjs",
    "dev:claim-conversations": "node scripts/dev-claim-conversations.mjs",
    "dev:seed-demo-history": "node scripts/dev-seed-demo-history.mjs",
    "dev:reset-xiaoming": "node scripts/dev-reset-xiaoming.mjs"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "^5.1.0",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.5",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "framer-motion": "^12.23.24",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.555.0",
    "marked": "^18.0.4",
    "openai": "^6.37.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.94.2",
    "uuid": "^14.0.0",
    "vite": "^8.0.10",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "autocannon": "^8.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
